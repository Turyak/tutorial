{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/user_profile.schema.json",
  "title": "UserProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "age",
    "sex",
    "heightCm",
    "weightKg",
    "activityLevel",
    "goal",
    "createdAt"
  ],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "age": { "type": "integer", "minimum": 14, "maximum": 100 },
    "sex": { "type": "string", "enum": ["male", "female", "other", "prefer_not_to_say"] },
    "heightCm": { "type": "number", "minimum": 120, "maximum": 230 },
    "weightKg": { "type": "number", "minimum": 35, "maximum": 250 },
    "familyStatus": { "type": "string", "enum": ["single", "partner", "married", "other"] },
    "activityLevel": { "type": "string", "enum": ["low", "moderate", "high"] },
    "goal": {
      "type": "string",
      "enum": ["fat_loss", "maintenance", "endurance", "strength", "stress_reduction", "sleep_quality"]
    },
    "targetBodyFatPercent": { "type": "number", "minimum": 3, "maximum": 50 },
    "goalDeadline": { "type": "string", "format": "date" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
