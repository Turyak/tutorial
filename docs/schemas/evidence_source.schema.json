{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/evidence_source.schema.json",
  "title": "EvidenceSource",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "sourceType", "url", "evidenceLevel"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 3 },
    "sourceType": { "type": "string", "enum": ["meta_analysis", "rct", "guideline", "systematic_review"] },
    "url": { "type": "string", "format": "uri" },
    "evidenceLevel": { "type": "string", "enum": ["A", "B", "C"] },
    "contraindications": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 }
    },
    "notes": { "type": "string" }
  }
}
